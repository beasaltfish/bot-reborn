CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
# A second of audio may be in flight. At lwIP's default (5760 B) a socket
# stops being writable with ~2.9 kB unsent, and esp_websocket_client treats a
# send that times out as a dead connection: a 150 ms Wi-Fi stall would
# disconnect the body. The watchdogs on both sides decide "gone", not this.
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=32768
# The chip is an N16R8: 16 MB of flash. The default 2 MB table left the app 1 MB.
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
# The chip is an N16R8: 8 MB of Octal PSRAM, for the pet's JPEG frames (GPIO
# 33-37 belong to it; no pin in board.h is there).
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
