# Wrangler / Cloudflare
.wrangler/
.dev.vars

# Dependencies and build output (this project has no build step; kept in case
# a toolchain is added later)
node_modules/
dist/
# `spike/` was ignored here on the assumption these pages get deleted once they
# have answered their question. They are kept instead: ⑤ and ⑥ were each
# reopened by a later finding, and a probe that is already calibrated against
# this phone is worth more than the shelf space.

# sherpa-onnx models and WASM: large, fetched by script, not vendored
web/models/

# Connectivity-test fixture audio: each person's own voice, recorded locally
# per web/fixtures/README.md, never someone else's sample.
web/fixtures/*.wav

# Personal design notes and specs (Chinese, single-author working documents)
docs/design-notes/
docs/superpowers/

