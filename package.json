{
  "name": "bot-reborn",
  "version": "1.0.0",
  "description": "Voice-controlled toy car: phone drives an FT232H over WebUSB in async bitbang mode.",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "start": "node server/main.js",
    "add-character": "node server/tools/add-character.js",
    "admin:build": "vite build --config admin/vite.config.ts",
    "admin:dev": "vite --config admin/vite.config.ts",
    "test": "node --test \"test/**/*.test.js\" && vitest run --config admin/vite.config.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p admin"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.20.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/w3c-web-usb": "^1.0.14",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^29.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sherpa-onnx-node": "^1.13.8",
    "ws": "^8.22.0"
  }
}
