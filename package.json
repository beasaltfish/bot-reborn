{
  "name": "bot-reborn",
  "version": "1.0.0",
  "description": "Voice-controlled toy car: phone drives an FT232H over WebUSB in async bitbang mode.",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "start": "node server/main.js",
    "add-character": "node server/tools/add-character.js",
    "build": "vite build",
    "dev": "node --watch-path=server --watch-path=core server/main.js --dev",
    "test": "node --test \"test/**/*.test.js\" && vitest run --config admin/vite.config.ts",
    "firmware:test": "cmake -S firmware/test -B firmware/build-host && cmake --build firmware/build-host && ctest --test-dir firmware/build-host --output-on-failure",
    "typecheck": "tsc --noEmit && tsc --noEmit -p admin",
    "pet:render": "node tools/pet/render.js"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.20.2",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@types/w3c-web-usb": "^1.0.14",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^29.1.1",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  },
  "dependencies": {
    "@fontsource/fredoka": "^5.3.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sherpa-onnx-node": "^1.13.8",
    "three": "^0.186.1",
    "ws": "^8.22.0"
  }
}
