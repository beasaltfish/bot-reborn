{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM"],
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "types": ["node", "w3c-web-usb"]
  },
  "include": ["core/**/*.js", "phone/**/*.js", "phone/**/*.d.ts", "sim/**/*.js", "test/**/*.js", "server/**/*.js"]
}
